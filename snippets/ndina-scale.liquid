{%- assign nd_w = product.metafields.ndina.width_cm.value -%}
{%- assign nd_h = product.metafields.ndina.height_cm.value -%}
{%- if nd_w != blank and nd_h != blank -%}
  {%- assign nd_ax = nd_w | times: 0.5 | minus: 127 | times: -1 -%}
  {%- assign nd_ay = 63 | minus: nd_h -%}
  {%- assign nd_ay2 = 63 | minus: 29.7 -%}
  {%- assign nd_vy = nd_ay | minus: 6 -%}
  {%- if nd_vy > 0 -%}{%- assign nd_vy = 0 -%}{%- endif -%}
  {%- assign nd_vh = 200 | minus: nd_vy -%}
  {%- assign nd_a4x = nd_ax | plus: nd_w | plus: 8 -%}
  {%- if nd_a4x < 170 -%}{%- assign nd_a4x = 170 -%}{%- endif -%}
  {%- assign nd_a4t = nd_a4x | plus: 10.5 -%}
  <details class="ndina-scale">
    <summary class="ndina-scale__summary"><span>See it to scale</span><span class="ndina-scale__icon" aria-hidden="true"></span></summary>
    <div class="ndina-scale__body">
      <svg class="ndina-scale__svg" viewBox="0 {{ nd_vy }} 300 {{ nd_vh }}" role="img" aria-label="{{ product.title | escape }} shown to scale above a lounge chair and side table with a tanoa, beside an A4 sheet and a 175 cm tall person">
        <rect y="{{ nd_vy }}" width="300" height="{{ 188 | minus: nd_vy }}" fill="#EFE7DC"/>
        <rect y="188" width="300" height="12" fill="#CDBBA3"/>
        <rect x="64" y="103" width="62" height="60" rx="10" fill="#B84A30"/>
        <rect x="56" y="142" width="22" height="30" rx="8" fill="#A3402A"/>
        <rect x="64" y="146" width="84" height="22" rx="7" fill="#C25A3E"/>
        <rect x="70" y="168" width="4" height="20" fill="#5a3a2a" transform="rotate(6 72 168)"/>
        <rect x="136" y="168" width="4" height="20" fill="#5a3a2a" transform="rotate(-6 138 168)"/>
        <rect x="152" y="138" width="52" height="3" rx="1" fill="#5a3a2a"/>
        <rect x="156" y="141" width="3" height="47" fill="#5a3a2a"/>
        <rect x="197" y="141" width="3" height="47" fill="#5a3a2a"/>
        <rect x="161" y="126" width="7" height="12" rx="1.5" fill="#6b4425"/>
        <rect x="188" y="126" width="7" height="12" rx="1.5" fill="#6b4425"/>
        <path d="M158 122 L198 122 Q196 134 178 134 Q160 134 158 122 Z" fill="#4a3020"/>
        <path d="M169 123 L187 123 L178 135 Z" fill="#b8843f"/>
        <ellipse cx="178" cy="122" rx="22" ry="3" fill="#7a5230"/>
        {%- if product.featured_image -%}
          <image href="{{ product.featured_image | image_url: width: 700 }}" x="{{ nd_ax }}" y="{{ nd_ay }}" width="{{ nd_w }}" height="{{ nd_h }}" preserveAspectRatio="xMidYMid slice"/>
        {%- endif -%}
        <rect x="{{ nd_ax }}" y="{{ nd_ay }}" width="{{ nd_w }}" height="{{ nd_h }}" fill="none" stroke="#222" stroke-width=".6"/>
        <rect x="{{ nd_a4x }}" y="{{ nd_ay2 }}" width="21" height="29.7" fill="#fff" stroke="#555" stroke-width=".4"/>
        <text x="{{ nd_a4t }}" y="{{ nd_ay2 | plus: 17 }}" font-size="5" fill="#555" text-anchor="middle">A4</text>
        <g fill="#6b5f55" fill-opacity=".55" transform="translate(236,13)">
          <circle cx="22" cy="16" r="10"/><rect x="8" y="28" width="28" height="78" rx="12"/><rect x="11" y="100" width="10" height="75"/><rect x="23" y="100" width="10" height="75"/>
        </g>
      </svg>
      <p class="ndina-scale__note">Artwork {{ nd_w }} &times; {{ nd_h }} cm, shown to scale with an A4 sheet (21 &times; 29.7 cm) and a 175 cm figure. Illustrative only.</p>
    </div>
  </details>
{%- endif -%}
