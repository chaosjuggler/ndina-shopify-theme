{%- assign nd_w = product.metafields.ndina.width_cm.value -%}
{%- assign nd_h = product.metafields.ndina.height_cm.value -%}
{%- if nd_w != blank and nd_h != blank -%}
  {%- assign nd_ax = 58 -%}
  {%- assign nd_ay = nd_h | times: 0.5 | minus: 70 | times: -1 -%}
  {%- assign nd_bx = nd_w | plus: 70 -%}
  {%- assign nd_by = 29.7 | times: 0.5 | minus: 70 | times: -1 -%}
  {%- assign nd_vw = nd_bx | plus: 33 -%}
  <div class="ndina-scale">
    <p class="ndina-scale__title">See it to scale</p>
    <svg class="ndina-scale__svg" viewBox="0 0 {{ nd_vw }} 176" role="img" aria-label="{{ product.title | escape }} shown to scale next to an A4 sheet and a 175 cm tall person">
      <line x1="0" y1="175" x2="{{ nd_vw }}" y2="175" stroke="currentColor" stroke-opacity=".25" stroke-width=".6"/>
      <g fill="currentColor" fill-opacity=".18">
        <circle cx="22" cy="16" r="10"/>
        <rect x="8" y="28" width="28" height="78" rx="12"/>
        <rect x="11" y="100" width="10" height="75"/>
        <rect x="23" y="100" width="10" height="75"/>
      </g>
      {%- if product.featured_image -%}
        <image href="{{ product.featured_image | image_url: width: 700 }}" x="{{ nd_ax }}" y="{{ nd_ay }}" width="{{ nd_w }}" height="{{ nd_h }}" preserveAspectRatio="xMidYMid slice"/>
      {%- endif -%}
      <rect x="{{ nd_ax }}" y="{{ nd_ay }}" width="{{ nd_w }}" height="{{ nd_h }}" fill="none" stroke="currentColor" stroke-width=".8"/>
      <rect x="{{ nd_bx }}" y="{{ nd_by }}" width="21" height="29.7" fill="#fff" stroke="currentColor" stroke-opacity=".6" stroke-width=".6"/>
      <text x="{{ nd_bx }}" y="{{ nd_by | plus: 36 }}" font-size="6" fill="currentColor">A4</text>
    </svg>
    <p class="ndina-scale__note">Artwork {{ nd_w }} &times; {{ nd_h }} cm, shown beside an A4 sheet (21 &times; 29.7 cm) and a 175 cm figure.</p>
  </div>
{%- endif -%}
